<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Audio mode and routing during a call (WebRTC audio device module) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Asked for when the person scans a QR code (safety number, invitation) or takes a photo or records a video from the chat
         (the camera app writes into a private folder of ours and the file is sent like any other attachment) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Only asked for when the person shares their position: approximate first, exact only if they choose "Exakt position".
         The position is read once with the platform LocationManager; no Google Play services, no background location. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Expedited sync on Android 11 and older runs as a short foreground service (WorkManager) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Calls: the foreground service of a call in progress (CallService), started from the visible call screen -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Kept on purpose: FOREGROUND_SERVICE_PHONE_CALL (the phoneCall service type of CallService) requires MANAGE_OWN_CALLS to be held.
         We do not register a self-managed ConnectionService with it; the call is our own, over the app's encrypted signalling. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- An incoming call takes over the screen (Android 14+ lets the user switch this off, see the settings) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- The ringing vibration, and the proximity sensor that turns the screen off at the ear during a voice call -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:name=".SwahnChatApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SwahnChat">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The share targets of the conversation shortcuts (direct share), see res/xml/shortcuts.xml -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!--
            "Share" from other apps. Exported on purpose, with intent filters for SEND and SEND_MULTIPLE only. Everything it
            receives is untrusted: only content:// URIs are read (never file://), copied with a size limit into private
            storage; nothing is shown while the app lock is on (see ShareReceiverActivity).
        -->
        <activity
            android:name=".ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
            The call screen. Not exported: started by our own PendingIntents and by the app itself. Shows over the lock screen and
            turns the screen on (set in code, for Android 8.0 too); nothing but the call is ever shown from there (see CallActivity).
        -->
        <activity
            android:name=".call.CallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />

        <!-- Decline action of the ringing notification; only our own PendingIntent reaches it -->
        <receiver android:name=".call.CallDeclineReceiver" android:exported="false" />

        <!-- The call in progress; started from CallActivity only -->
        <service
            android:name=".call.CallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone|camera" />

        <!-- Notification "mark as read" action; only our own PendingIntent reaches it -->
        <receiver android:name=".platform.notify.MarkReadReceiver" android:exported="false" />

        <!-- Notification inline reply (RemoteInput); only our own explicit PendingIntent reaches it -->
        <receiver android:name=".platform.notify.ReplyReceiver" android:exported="false" />

        <!-- UnifiedPush: the distributor binds to this service to deliver endpoints and wake-ups -->
        <service
            android:name=".platform.push.SwahnChatPushService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <!-- Decrypted files are shared to other apps only through copies in the cache folder -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- WorkManager is started on demand with the Hilt worker factory (SwahnChatApp.workManagerConfiguration) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
