# OPTIONAL OnFailure hook: posts "<unit> failed" to an ntfy topic that only the administrator subscribes to.
# Hook it up by uncommenting OnFailure=swahnchat-notify-failure@%n.service in swahnchat-verify-backup.service
# (or swahnchat-backup.service) and then `sudo systemctl daemon-reload`.
# Install:  sudo cp swahnchat-notify-failure@.service /etc/systemd/system/
#           sudo install -d -m 755 /etc/swahnchat
#           echo 'NTFY_ADMIN_URL=https://ntfy.example.org/swahnchat-admin-CHANGE-ME' | sudo tee /etc/swahnchat/admin-ntfy.env
#           sudo chmod 600 /etc/swahnchat/admin-ntfy.env
# Use a long, unguessable topic name (a public ntfy topic is readable by anyone who knows its name). The message
# carries only the unit name and host, never data from Swahn Chat. Test: sudo systemctl start swahnchat-notify-failure@test.service
[Unit]
Description=Tell the administrator that %i failed

[Service]
Type=oneshot
EnvironmentFile=/etc/swahnchat/admin-ntfy.env
ExecStart=/usr/bin/curl -fsS --max-time 20 -H "Title: Swahn Chat: %i failed" -H "Priority: high" -H "Tags: warning" -d "%i failed on %H. Run: journalctl -u %i -n 50" ${NTFY_ADMIN_URL}
