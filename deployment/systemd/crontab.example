# Alternative to the systemd timer: `crontab -e` as the user that runs docker.
# Retention (SWAHNCHAT_BACKUP_KEEP, default 14) and the optional rclone upload (SWAHNCHAT_BACKUP_RCLONE_REMOTE)
# are read from deployment/.env; put them in front of the command to override, e.g.
#   SWAHNCHAT_BACKUP_KEEP=30 SWAHNCHAT_BACKUP_RCLONE_REMOTE=swahnchat-crypt:backups /home/pi/...
# cron has a minimal PATH: add the directory of docker/rclone if they are not in /usr/bin.
15 3 * * * /home/pi/swahn-chat/deployment/backup.sh /home/pi/swahnchat-backups >> /home/pi/swahnchat-backups/backup.log 2>&1
