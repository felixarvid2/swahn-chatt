# Install:  sudo cp familychat-backup.{service,timer} /etc/systemd/system/
#           (edit User=, WorkingDirectory= and the paths first)
#           sudo systemctl daemon-reload && sudo systemctl enable --now familychat-backup.timer
[Unit]
Description=FamilyChat nightly backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/familychat/deployment
# Retention and the optional rclone upload come from deployment/.env (FAMILYCHAT_BACKUP_KEEP, FAMILYCHAT_BACKUP_RCLONE_REMOTE).
# rclone reads its config from ~/.config/rclone of User=. Uncomment to set them here instead:
#Environment=FAMILYCHAT_BACKUP_KEEP=30
#Environment=FAMILYCHAT_BACKUP_RCLONE_REMOTE=familychat-crypt:backups
ExecStart=/home/pi/familychat/deployment/backup.sh /home/pi/familychat-backups
