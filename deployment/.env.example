# FamilyChat deployment settings. Copy to `.env` (git-ignored) and edit. Never commit `.env`.
# Every FAMILYCHAT_* variable below is read by the backend container.

# --- required ---------------------------------------------------------------------------------
# Signs access tokens. At least 32 bytes; the server refuses to start in production without it.
# Generate one with:   openssl rand -base64 48
# Changing it later logs everybody out (refresh tokens keep working, access tokens are re-issued).
FAMILYCHAT_SECRET_KEY=

# --- general ----------------------------------------------------------------------------------
# production (default) or development. Development enables /api/v1/docs and allows the `seed-dev` CLI.
FAMILYCHAT_ENV=production
# DEBUG, INFO, WARNING, ERROR. Logs are JSON lines on stdout (docker compose logs backend).
FAMILYCHAT_LOG_LEVEL=INFO
# Serve Swagger UI at /api/v1/docs and /api/v1/openapi.json even in production (default false).
FAMILYCHAT_EXPOSE_DOCS=false

# --- storage (inside the container; the compose file mounts the `familychat-data` volume at /data) --
# FAMILYCHAT_DATA_DIR=/data
# SQLite file by default: sqlite:////data/familychat.db. PostgreSQL: postgresql+psycopg://user:pass@host/db
# (the driver is in the image, migrations run on start; see docs/RASPBERRY_PI_SETUP.md, "Optional: PostgreSQL").
# FAMILYCHAT_DATABASE_URL=
# FAMILYCHAT_ATTACHMENTS_DIR=/data/attachments
# Largest single (encrypted) attachment in MiB.
FAMILYCHAT_MAX_ATTACHMENT_MB=100
# Storage quota per user in MiB.
FAMILYCHAT_USER_QUOTA_MB=2048

# --- sessions -----------------------------------------------------------------------------------
FAMILYCHAT_ACCESS_TOKEN_MINUTES=15
FAMILYCHAT_REFRESH_TOKEN_DAYS=60
# Active devices per account (every login on a phone is a device). Logging in beyond this fails with
# 409 device_limit until a device is removed.
FAMILYCHAT_MAX_DEVICES_PER_USER=10
# Seconds between checks that an open WebSocket's session is still valid (catches revocations made with the CLI).
FAMILYCHAT_WS_REVALIDATE_SECONDS=60
# Opt-in "online" status (users switch it on in the app): seconds between announcements of one user's changes to
# their contacts. Nothing is sent for users who did not opt in.
FAMILYCHAT_PRESENCE_DEBOUNCE_SECONDS=10

# --- retention and disk (hourly maintenance job, /readyz) ---------------------------------------
# Delivered message envelopes (ciphertext) are deleted after this many days. Undelivered ones for active devices stay.
FAMILYCHAT_ENVELOPE_RETENTION_DAYS=30
# Audit log entries (GET /api/v1/admin/audit, `cli audit`) are deleted after this many days.
FAMILYCHAT_AUDIT_RETENTION_DAYS=180
# /readyz answers 503 "low_disk" when the data volume has less free space than this many MiB (0 = no check).
FAMILYCHAT_MIN_FREE_DISK_MB=200
# Weekly database maintenance (SQLite: optimize, ANALYZE, WAL checkpoint, VACUUM only when over 20 % of the file is
# free pages and the server is quiet; PostgreSQL: ANALYZE). Days between runs, 0 = off. Result: GET /admin/stats.
FAMILYCHAT_DB_MAINTENANCE_DAYS=7

# --- network ------------------------------------------------------------------------------------
# Comma separated CIDRs of reverse proxies whose X-Forwarded-For header is believed (used only for rate
# limiting per client IP). 172.16.0.0/12 covers Docker's bridge networks, i.e. Caddy in this compose file
# and `tailscale serve` on the host (traffic arrives from the bridge gateway). Leave empty when clients
# connect directly.
FAMILYCHAT_TRUSTED_PROXIES=172.16.0.0/12
# Hint for `python -m app.cli check-config`: set true when a reverse proxy (Caddy, tailscale serve) is in front.
# The check then warns if FAMILYCHAT_TRUSTED_PROXIES is empty (all clients would share the proxy's address).
FAMILYCHAT_BEHIND_PROXY=false
# Send Strict-Transport-Security (browsers then refuse plain http for a year). Turn on only when every client reaches
# the server over HTTPS (Caddy or `tailscale serve`).
FAMILYCHAT_HSTS=false

# --- push (UnifiedPush) -------------------------------------------------------------------------
# Only https:// push endpoints are used unless this is true. Keep false in production.
FAMILYCHAT_PUSH_ALLOW_HTTP=false
# Host names that push endpoints may point to (guards against the server being used to POST to
# arbitrary URLs). REQUIRED for push in production: set it to your ntfy host, e.g. ntfy.pi.example.ts.net
# (comma separated for several). While empty, push registration is refused (409 push_not_configured) and no
# push is sent. IP addresses are refused as hosts unless listed here.
FAMILYCHAT_PUSH_ALLOWED_HOSTS=

# --- calls (optional; 1:1 audio/video, WebRTC between the phones) -------------------------------
# Call signalling (offer/answer/ICE/hangup) travels as end-to-end encrypted `call` messages; the server never sees it.
# Such messages are deleted, delivered or not, after this many seconds (minimum 30).
FAMILYCHAT_CALL_RETENTION_SECONDS=600
# TURN relay handed to the phones by GET /api/v1/calls/turn (only to logged-in users). Leave empty to use direct
# connections only (fine on one Tailscale network). Comma separated, for example
#   turn:pi.your-tailnet.ts.net:3478?transport=udp,turn:pi.your-tailnet.ts.net:3478?transport=tcp
# (add turns:host:5349?transport=tcp when certificates are mounted, see docs/RASPBERRY_PI_SETUP.md, section 12).
FAMILYCHAT_TURN_URLS=
# Shared secret between the backend and coturn (compose profile `turn` reads this same value). At least 32 bytes,
# required when FAMILYCHAT_TURN_URLS is set. Never logged. Generate:   openssl rand -base64 48
FAMILYCHAT_TURN_SECRET=
# Optional STUN servers for the phones, e.g. stun:pi.your-tailnet.ts.net:3478 (coturn answers STUN too).
FAMILYCHAT_STUN_URLS=
# Lifetime of the TURN credentials in seconds (60..86400).
FAMILYCHAT_TURN_TTL_SECONDS=3600
# profile `turn` (coturn): realm, the public IP when the Pi is behind NAT (PUBLIC or PUBLIC/PRIVATE), and whether the
# relay may send to Tailscale addresses (100.64.0.0/10). Default false: see docs/RASPBERRY_PI_SETUP.md, section 12.
TURN_REALM=familychat
TURN_EXTERNAL_IP=
TURN_ALLOW_TAILNET_PEERS=false
# profile `turn`: folder with fullchain.pem and privkey.pem (readable by "nobody") to enable turns: on port 5349.
# TURN_CERT_DIR=./turn-certs

# --- admin alerts (optional) ---------------------------------------------------------------------
# A full ntfy topic URL (https) that only you subscribe to. The server posts a short plain-text alert (no user names or
# content) on low disk, failing maintenance, a login lockout, a refresh token reuse and a new administrator.
FAMILYCHAT_ADMIN_NTFY_URL=
# Access token, only if the ntfy server requires login. Treat it as a secret.
FAMILYCHAT_ADMIN_NTFY_TOKEN=

# --- optional compose profiles ------------------------------------------------------------------
# profile `caddy`: the public DNS name that points at this machine (A/AAAA record, ports 80+443 open).
FAMILYCHAT_DOMAIN=
# profile `caddy` + `ntfy`: DNS name of the ntfy server (defaults to a local-only name that gets no certificate).
NTFY_DOMAIN=ntfy.localhost
# profile `caddy`: largest request body Caddy lets through to attachment uploads. Keep it a little above
# FAMILYCHAT_MAX_ATTACHMENT_MB (default 100 MiB); every other request is capped at 9 MB.
CADDY_MAX_UPLOAD=110MB
# profile `ntfy`: the URL phones use to reach ntfy over https, e.g. https://ntfy.example.org
# or, with Tailscale, https://pi.your-tailnet.ts.net:8443
NTFY_BASE_URL=

# --- Tailscale sidecar (compose profile `tailscale`) and install-pi.sh -----------------------------
# Profiles started by a plain `docker compose up -d`, comma separated: caddy, ntfy, tailscale, turn.
# COMPOSE_PROFILES=
# profile `tailscale`: auth key from https://login.tailscale.com/admin/settings/keys (reusable not needed; it is
# only used for the first login, the node state is kept in the tailscale-state volume). Treat it as a secret.
TS_AUTHKEY=
# profile `tailscale`: the node name; the address becomes https://<TS_HOSTNAME>.<your-tailnet>.ts.net
TS_HOSTNAME=familychat

# --- backups (read by backup.sh; environment variables win over these) ----------------------------
# How many of the newest backup archives to keep (at least 1).
FAMILYCHAT_BACKUP_KEEP=14
# Optional: after each backup run `rclone copy` of the backup directory to this remote, e.g. a crypt remote
# "familychat-crypt:backups" (rclone must be installed and configured for the user that runs backup.sh).
FAMILYCHAT_BACKUP_RCLONE_REMOTE=
# `backup.sh --verify-latest` (monthly systemd timer) fails when the newest archive is older than this many days.
FAMILYCHAT_BACKUP_MAX_AGE_DAYS=3
